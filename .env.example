# Copy to .env and adjust for your environment.

OBSLY_ENVIRONMENT=development
OBSLY_FLEET_NAME=default-fleet
OBSLY_AWS_REGION=us-east-1

# Kafka
OBSLY_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OBSLY_KAFKA_TOPIC_PREFIX=obsly
OBSLY_KAFKA_CONSUMER_GROUP=obsly-consumers
OBSLY_KAFKA_NUM_PARTITIONS=3
OBSLY_KAFKA_REPLICATION_FACTOR=1

# Redis targets to monitor (comma separated URLs are parsed by pydantic-settings as JSON list;
# simplest is a single value list, e.g. '["redis://localhost:6379/0"]')
OBSLY_REDIS_URL=redis://localhost:6379/0
OBSLY_REDIS_MONITORED_URLS=["redis://localhost:6379/0"]
OBSLY_REDIS_COLLECT_INTERVAL_SECONDS=15

# MySQL targets to monitor
OBSLY_MYSQL_DSN=mysql+pymysql://obsly:obsly@localhost:3306/obsly
OBSLY_MYSQL_MONITORED_DSNS=["mysql+pymysql://obsly:obsly@localhost:3306/obsly"]
OBSLY_MYSQL_COLLECT_INTERVAL_SECONDS=15

# Kubernetes
OBSLY_K8S_IN_CLUSTER=false
OBSLY_K8S_KUBECONFIG_PATH=
OBSLY_K8S_NAMESPACES=["default"]
OBSLY_K8S_COLLECT_INTERVAL_SECONDS=15

# Storage
OBSLY_STORAGE_DATABASE_URL=sqlite:///./obsly.db
OBSLY_STORAGE_RETENTION_DAYS=30
OBSLY_STORAGE_HOT_WINDOW_SECONDS=900

# Prometheus exporter
OBSLY_EXPORTER_HOST=0.0.0.0
OBSLY_EXPORTER_PORT=9464
OBSLY_EXPORTER_REFRESH_INTERVAL_SECONDS=10

# Logging
OBSLY_LOG_LEVEL=INFO
OBSLY_LOG_JSON_OUTPUT=true
OBSLY_LOG_LOG_DIR=./logs

# Alerting
OBSLY_ALERT_SLACK_WEBHOOK_URL=
OBSLY_ALERT_PAGERDUTY_ROUTING_KEY=
